{
  "name": "coach-reflection-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create coach-reflection-bot",
    "db:migrate": "wrangler d1 migrations apply coach-reflection-bot --remote",
    "db:migrate:local": "wrangler d1 migrations apply coach-reflection-bot --local",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
